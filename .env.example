# ============================================
# Manufacturing Tracking System
# Environment Variables Configuration
# ============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control!

# ============================================
# API Configuration
# ============================================
VITE_API_BASE_URL=http://localhost:3000/api
VITE_MOCK_API=true

# ============================================
# Google OAuth
# ============================================
# Get from: https://console.cloud.google.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id-here

# ============================================
# Error Tracking (Sentry)
# ============================================
VITE_ERROR_TRACKING_ENABLED=true
# DSN format: https://key@sentry.io/project-id
VITE_ERROR_TRACKING_DSN=

# ============================================
# Monitoring & Analytics
# ============================================
VITE_MONITORING_ENABLED=true
VITE_MONITORING_ENV=development

# ============================================
# Application Settings
# ============================================
VITE_APP_VERSION=1.0.0
VITE_LOG_LEVEL=debug
VITE_APP_NAME=Manufacturing Tracking System

# ============================================
# Feature Flags
# ============================================
VITE_FEATURE_OFFLINE_MODE=true
VITE_FEATURE_REAL_TIME_UPDATES=true
VITE_FEATURE_QUALITY_INSPECTION=true
VITE_FEATURE_AUDIT_TRAIL=true
