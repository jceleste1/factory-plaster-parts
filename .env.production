# ============================================
# Production Environment Variables
# ============================================

# API Configuration
VITE_API_BASE_URL=https://api.example.com/api
VITE_MOCK_API=false

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-production-google-client-id

# Error Tracking (Sentry)
VITE_ERROR_TRACKING_ENABLED=true
VITE_ERROR_TRACKING_DSN=https://key@sentry.io/production-project-id

# Monitoring & Analytics
VITE_MONITORING_ENABLED=true
VITE_MONITORING_ENV=production

# Application Settings
VITE_APP_VERSION=1.0.0
VITE_LOG_LEVEL=error
VITE_APP_NAME=Manufacturing Tracking System

# Feature Flags
VITE_FEATURE_OFFLINE_MODE=true
VITE_FEATURE_REAL_TIME_UPDATES=true
VITE_FEATURE_QUALITY_INSPECTION=true
VITE_FEATURE_AUDIT_TRAIL=true
